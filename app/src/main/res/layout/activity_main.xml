<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090A0D">

    <LinearLayout
        android:id="@+id/browserToolbar"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:gravity="center_vertical"
        android:background="#111318"
        android:elevation="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:contentDescription="@string/forward"
            android:src="@drawable/ic_arrow_forward"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:contentDescription="@string/home"
            android:src="@drawable/ic_home"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true" />

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="2dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:hint="@string/enter_url"
            android:textColor="#F5F7FA"
            android:textColorHint="#7F8794"
            android:textSize="13sp"
            android:background="@drawable/url_bar_background"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:selectAllOnFocus="true" />

        <ImageButton
            android:id="@+id/btnVoice"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:contentDescription="@string/voice_search"
            android:src="@drawable/ic_mic"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="8dp"
            android:contentDescription="@string/more_options"
            android:src="@drawable/ic_more_vert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:visibility="gone"
        style="?android:attr/progressBarStyleHorizontal"
        android:progressDrawable="@drawable/progress_bar" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
